// Windows resources: the application icon and the version information block
// that Explorer shows under file properties.
//
// Keep FILEVERSION and the strings in step with the version in Cargo.toml.

#include <winver.h>

// Resource id 1 is what Windows uses for the executable's own icon.
1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04B0 = Unicode.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "vips-gui"
            VALUE "FileDescription",  "Batch image conversion with libvips"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "vips-gui"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "vips-gui.exe"
            VALUE "ProductName",      "vips-gui"
            VALUE "ProductVersion",   "0.1.0.0"
            VALUE "Comments",         "Requires libvips to be installed and on PATH."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
